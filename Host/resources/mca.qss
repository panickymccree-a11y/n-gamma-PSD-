/* MCA Studio — compact, flat, professional light theme */

QWidget {
    color: #20252b;
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 12px;
    selection-background-color: #2563a6;
    selection-color: #ffffff;
}

QMainWindow {
    background: #edf0f3;
}

QMainWindow::separator {
    width: 1px;
    height: 1px;
    background: #c8cfd7;
}

QMenuBar {
    background: #f7f8fa;
    border-bottom: 1px solid #d3d8de;
    padding: 2px 6px;
}

QMenuBar::item {
    padding: 5px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    color: #173f70;
    background: #e4edf7;
}

QMenu {
    background: #ffffff;
    border: 1px solid #c8cfd7;
    padding: 4px;
}

QMenu::item {
    padding: 6px 30px 6px 10px;
    border-radius: 3px;
}

QMenu::item:selected {
    color: #173f70;
    background: #e4edf7;
}

QMenu::item:disabled {
    color: #9aa3ad;
}

QMenu::separator {
    height: 1px;
    margin: 4px 8px;
    background: #e2e6ea;
}

QToolBar {
    background: #f7f8fa;
    border: none;
    border-bottom: 1px solid #d3d8de;
    padding: 3px 6px;
    spacing: 2px;
}

QToolBar::separator {
    width: 1px;
    margin: 4px 5px;
    background: #d3d8de;
}

QToolButton {
    color: #30363d;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px 7px;
}

QToolButton:hover {
    color: #173f70;
    background: #e9eff6;
    border-color: #c5d3e2;
}

QToolButton:pressed,
QToolButton:checked {
    color: #ffffff;
    background: #2563a6;
    border-color: #1f548e;
}

QToolButton:disabled {
    color: #a7afb8;
    background: transparent;
    border-color: transparent;
}

QDockWidget {
    color: #20252b;
    background: #f7f8fa;
    border: 1px solid #c8cfd7;
    titlebar-close-icon: none;
}

QDockWidget::title {
    color: #30363d;
    background: #f1f3f5;
    border-bottom: 1px solid #d3d8de;
    padding: 7px 9px;
    font-weight: 600;
    text-align: left;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #d5dae0;
    border-radius: 4px;
    margin-top: 10px;
    padding: 10px 8px 8px 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #44505c;
    background: #ffffff;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    min-height: 22px;
    color: #20252b;
    background: #ffffff;
    border: 1px solid #b9c1ca;
    border-radius: 3px;
    padding: 2px 6px;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover {
    border-color: #8f9ba7;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #2563a6;
}

QLineEdit:read-only {
    color: #596572;
    background: #f4f6f8;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
    color: #9aa3ad;
    background: #eef1f4;
    border-color: #d5dae0;
}

QComboBox::drop-down {
    width: 20px;
    border: none;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    width: 16px;
    border: none;
    background: transparent;
}

QPushButton {
    min-height: 23px;
    color: #30363d;
    background: #f7f8fa;
    border: 1px solid #b9c1ca;
    border-radius: 3px;
    padding: 3px 12px;
}

QPushButton:hover {
    color: #173f70;
    background: #edf3f9;
    border-color: #8da8c4;
}

QPushButton:pressed {
    color: #ffffff;
    background: #2563a6;
    border-color: #1f548e;
}

QPushButton:focus {
    border-color: #2563a6;
}

QPushButton:disabled {
    color: #9aa3ad;
    background: #eef1f4;
    border-color: #d5dae0;
}

QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
}

QTableWidget,
QTableView {
    color: #20252b;
    background: #ffffff;
    alternate-background-color: #f7f9fb;
    border: 1px solid #d3d8de;
    gridline-color: transparent;
    outline: none;
}

QTableWidget::item,
QTableView::item {
    min-height: 24px;
    padding: 3px 6px;
    border-bottom: 1px solid #edf0f3;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background: #edf3f9;
}

QTableWidget::item:selected,
QTableView::item:selected {
    color: #173f70;
    background: #dce9f6;
}

QHeaderView::section {
    color: #44505c;
    background: #f0f3f6;
    border: none;
    border-right: 1px solid #e0e4e8;
    border-bottom: 1px solid #c8cfd7;
    padding: 5px 7px;
    font-weight: 600;
}

QStatusBar {
    color: #596572;
    background: #f7f8fa;
    border-top: 1px solid #d3d8de;
    padding: 2px 5px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 1px 7px;
    color: #596572;
    font-size: 11px;
}

QLabel#acquisitionStatusBadge,
QLabel#deviceStatusBadge {
    border: 1px solid #d3d8de;
    border-radius: 3px;
    background: #ffffff;
    font-weight: 600;
}

QLabel#acquisitionStatusBadge[state="running"],
QLabel#deviceStatusBadge[state="online"] {
    color: #176b45;
    border-color: #b9d8c8;
    background: #eef8f2;
}

QLabel#acquisitionStatusBadge[state="paused"],
QLabel#deviceStatusBadge[state="connecting"] {
    color: #8a6200;
    border-color: #e0c98c;
    background: #fff8e5;
}

QLabel#acquisitionStatusBadge[state="error"],
QLabel[alert="true"],
QLabel[state="error"] {
    color: #a62b2b;
    font-weight: 600;
}

QLabel[state="active"] {
    color: #176b45;
}

QLabel#spectrumCursorOverlay {
    color: #ffffff;
    background: rgba(32, 37, 43, 205);
    border-radius: 3px;
    padding: 3px 8px;
    font-size: 11px;
}

QProgressBar {
    min-height: 14px;
    color: #44505c;
    background: #ffffff;
    border: 1px solid #c8cfd7;
    border-radius: 3px;
    text-align: center;
    font-size: 10px;
}

QProgressBar::chunk {
    background: #2563a6;
    border-radius: 2px;
}

QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #d3d8de;
}

QTabBar::tab {
    color: #596572;
    background: #edf0f3;
    border: 1px solid #d3d8de;
    border-bottom: none;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    padding: 6px 12px;
}

QTabBar::tab:selected {
    color: #173f70;
    background: #ffffff;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: #e4eaf0;
}

QSplitter::handle {
    background: #d3d8de;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QScrollBar:vertical {
    width: 10px;
    margin: 0;
    border: none;
    background: #eef1f4;
}

QScrollBar:horizontal {
    height: 10px;
    margin: 0;
    border: none;
    background: #eef1f4;
}

QScrollBar::handle {
    min-width: 24px;
    min-height: 24px;
    border-radius: 5px;
    background: #b5bec8;
}

QScrollBar::handle:hover {
    background: #929eaa;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    width: 0;
    height: 0;
    background: transparent;
}

QToolTip {
    color: #f7f8fa;
    background: #30363d;
    border: 1px solid #30363d;
    border-radius: 3px;
    padding: 5px 8px;
    font-size: 11px;
}
